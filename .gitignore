# Raw Unfallatlas releases (~360 MB) are downloaded, not versioned.
# The processed dataset is small enough to commit, and doing so lets the team
# and the deployed app use the cleaned crash table without reprocessing.
data/*
!data/.gitkeep
!data/processed/
data/processed/*
!data/processed/berlin_bike_2018_2025.csv
outputs/*
cache/*
__pycache__/
reports/
models/*

# Generated outputs
reports/*.html

.DS_Store
.venv/

# Keep folders
!models/.gitkeep
!outputs/maps/.gitkeep
!outputs/figures/.gitkeep
!reports/.gitkeep
cache/
**/cache/
*.graphml
